# Source: `langgraph dockerfile` (langgraph-cli), patched with:
#   * forward-slash auth path (the CLI emits Windows backslashes)
#   * lockfile-pinned installs (docker/requirements.lock.txt)
#   * CPU-only torch from the PyTorch wheel index
# Regenerate with: uv run python scripts/prepare_docker.py

FROM langchain/langgraph-api:3.11







# -- Adding local package . --
ADD . /deps/langgraph-fullstack-python
# -- End of local package . --



# -- Installing all local dependencies (lockfile-pinned) --
# The graph code is ADDed above; docker/requirements.lock.txt pins every
# third-party version that was tested, minus the CUDA-only packages.
RUN PYTHONDONTWRITEBYTECODE=1 uv pip install --system --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu "torch==2.14.0"
RUN PYTHONDONTWRITEBYTECODE=1 uv pip install --system --no-cache-dir \
        -c /api/constraints.txt \
        -r /deps/langgraph-fullstack-python/docker/requirements.lock.txt
RUN PYTHONDONTWRITEBYTECODE=1 uv pip install --system --no-cache-dir --no-deps \
        -e /deps/langgraph-fullstack-python
# -- End of local dependencies install --

ENV LANGGRAPH_AUTH='{"path": "/deps/langgraph-fullstack-python/src/react_agent/auth.py:auth"}'

ENV HF_HOME=/cache/huggingface
ENV HF_HUB_DISABLE_XET=1
ENV RAG_VECTORSTORE_PATH=/data/vectorstore
ENV LANGGRAPH_HTTP='{"app": "/deps/langgraph-fullstack-python/src/react_agent/app.py:app"}'

ENV LANGSERVE_GRAPHS='{"agent": "/deps/langgraph-fullstack-python/src/react_agent/graph.py:graph"}'







# -- Ensure user deps didn't inadvertently overwrite langgraph-api
RUN mkdir -p /api/langgraph_api /api/langgraph_runtime /api/langgraph_license && touch /api/langgraph_api/__init__.py /api/langgraph_runtime/__init__.py /api/langgraph_license/__init__.py
RUN PYTHONDONTWRITEBYTECODE=1 uv pip install --system --no-cache-dir --no-deps -e /api
# -- End of ensuring user deps didn't inadvertently overwrite langgraph-api --
# -- Removing build deps from the final image ~<:===~~~ --
RUN pip uninstall -y pip setuptools wheel
RUN rm -rf /usr/local/lib/python*/site-packages/pip* /usr/local/lib/python*/site-packages/setuptools* /usr/local/lib/python*/site-packages/wheel* && find /usr/local/bin -name "pip*" -delete || true
RUN rm -rf /usr/lib/python*/site-packages/pip* /usr/lib/python*/site-packages/setuptools* /usr/lib/python*/site-packages/wheel* && find /usr/bin -name "pip*" -delete || true
RUN uv pip uninstall --system pip setuptools wheel && rm /usr/bin/uv /usr/bin/uvx



WORKDIR /deps/langgraph-fullstack-python
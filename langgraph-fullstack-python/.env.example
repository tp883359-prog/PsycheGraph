# PsycheGraph environment template.
#
# Copy to `.env` for local development:  Copy-Item .env.example .env
# In Docker the file is passed explicitly:
#     docker compose -f docker/docker-compose.yml --env-file .env up -d
# Never commit the filled-in file; `.env` is ignored by git and by the image
# build context.

# ---------------------------------------------------------------------------
# Required secrets
# ---------------------------------------------------------------------------

# DeepSeek chat model. The only credential the agent itself needs.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# ---------------------------------------------------------------------------
# LangSmith tracing (optional)
# ---------------------------------------------------------------------------
# Leave both unset to run without tracing. The deployment guide explains when
# tracing is worth enabling and how to keep prompts/traces private.

# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=psychegraph

# ---------------------------------------------------------------------------
# API authentication (see docs/SECURITY_DEPLOYMENT.md)
# ---------------------------------------------------------------------------
# Unset = local-only demo mode: every request is accepted as `default_user`.
# Set = every API request (including /threads, /runs, /store, /docs) must carry
# `Authorization: Bearer <value>`. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
LANGGRAPH_DEMO_API_TOKEN=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL. Default: INFO.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Local knowledge base (RAG)
# ---------------------------------------------------------------------------
# BGE-M3 runs on this host; no cloud embedding service is used and no index is
# built at request time. EMBEDDING_DEVICE=cuda needs a CUDA image and GPU, so a
# small CPU deployment keeps it at `cpu`.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
RAG_VECTORSTORE_PATH=data/vectorstore
RAG_COLLECTION=psychegraph_theory
RAG_TOP_K=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
# false runs the graph without retrieval (evidence lists stay empty).
RAG_ENABLED=true

# Hugging Face cache. `HF_HOME` is where BGE-M3's ~2.2 GB land; mount it as a
# volume in production so a container restart does not re-download weights.
HF_HOME=.cache/huggingface
# Xet transfer backend is disabled: plain HTTPS downloads are more predictable
# behind restrictive networks.
HF_HUB_DISABLE_XET=1
# Skip Hugging Face hub metadata checks. The container defaults to 1 when the
# weights are already cached; set 0 for the very first download.
# HF_HUB_OFFLINE=0
# Set when pulling gated models; not needed for BAAI/bge-m3.
# HF_TOKEN=

# ---------------------------------------------------------------------------
# Outbound proxy (only when the host cannot reach the internet directly)
# ---------------------------------------------------------------------------
# The containers inherit these; empty means "no proxy", which is what a normal
# VPS wants. On a workstation whose only route out is a local proxy, use the
# address from inside Docker, not 127.0.0.1:
#     HTTP_PROXY=http://host.docker.internal:PORT  (PORT = the host proxy port)
#     HTTPS_PROXY=http://host.docker.internal:PORT
#     NO_PROXY=localhost,127.0.0.1,host.docker.internal
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Web application limits (Phase 10A)
# ---------------------------------------------------------------------------
# Input cap in Unicode characters (one Chinese character counts as one).
# 4000 characters is roughly 2500 tokens of Chinese input.
WEB_MAX_INPUT_CHARS=4000
# Per-session rolling windows enforced in the route handler. The values are read
# when the server starts, so changing them needs a restart.
WEB_RATE_LIMIT_PER_MINUTE=6
WEB_RATE_LIMIT_PER_HOUR=40
# One answer at a time per browser session; the UI shows a "busy" notice.
# Values above 1 are only safe with WEB_REPLICAS=1 (in-memory registry) and
# enough CPU headroom for parallel BGE-M3 use.
WEB_MAX_ACTIVE_RUNS_PER_SESSION=1
# Keep at 1: the conversation registry and the rate limiter live in process
# memory, so a second replica would let a session exceed both limits.
WEB_REPLICAS=1
